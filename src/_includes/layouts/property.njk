---
layout: layouts/base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Apartment",
  "name": {{ title | json | safe }},
  "description": {{ description | json | safe }},
  "url": {{ (site.url + page.url) | json | safe }},
  "image": [{{ (site.url + image) | json | safe }}{% for photo in gallery %},{{ (site.url + photo) | json | safe }}{% endfor %}],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ location | json | safe }},
    "addressLocality": "Beyoğlu",
    "addressRegion": "İstanbul",
    "addressCountry": "TR"
  },
  "offers": {
    "@type": "Offer",
    "url": {{ (site.url + page.url) | json | safe }},
    "price": {{ priceValue | json | safe }},
    "priceCurrency": {{ (priceCurrency or 'TRY') | json | safe }},
    "availability": "https://schema.org/InStock",
    "seller": { "@id": {{ (site.url + '/#business') | json | safe }} }
  },
  "additionalProperty": [{% for feature in features %}{ "@type": "PropertyValue", "name": "Özellik", "value": {{ feature | json | safe }} }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": {{ (site.url + '/') | json | safe }} },
    { "@type": "ListItem", "position": 2, "name": "İlanlar", "item": {{ (site.url + '/ilanlar/') | json | safe }} },
    { "@type": "ListItem", "position": 3, "name": {{ title | json | safe }}, "item": {{ (site.url + page.url) | json | safe }} }
  ]
}
</script>
<section class="page-hero"><div class="container page-title"><span class="badge {{ 'green' if status == 'Satılık' else 'red' }}">{{ status }} {{ propertyType }}</span><h1>{{ title }}</h1><p>{{ location }}</p></div></section>
<section class="section"><div class="container">
  {% set photoCount = 1 + (gallery | length) %}
  <div class="property-gallery" data-gallery data-title="{{ title }}">
    <div class="gallery-stage">
      <button class="gallery-main" type="button" data-gallery-open aria-label="Fotoğrafı büyüt">
        <img src="{{ image }}" alt="{{ title }}" data-gallery-main>
      </button>
      {% if photoCount > 1 %}
      <button class="gallery-arrow gallery-prev" type="button" data-gallery-prev aria-label="Önceki fotoğraf">‹</button>
      <button class="gallery-arrow gallery-next" type="button" data-gallery-next aria-label="Sonraki fotoğraf">›</button>
      <span class="gallery-count" data-gallery-count>1 / {{ photoCount }}</span>
      {% endif %}
    </div>
    {% if photoCount > 1 %}<div class="gallery-thumbs" aria-label="İlan fotoğrafları"><button type="button" class="gallery-thumb active" data-gallery-thumb data-src="{{ image }}" aria-label="1. fotoğrafı göster"><img src="{{ image }}" alt="" loading="lazy"></button>{% for photo in gallery %}<button type="button" class="gallery-thumb" data-gallery-thumb data-src="{{ photo }}" aria-label="{{ loop.index + 1 }}. fotoğrafı göster"><img src="{{ photo }}" alt="" loading="lazy"></button>{% endfor %}</div>{% endif %}
  </div>
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="İlan fotoğraf galerisi">
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Galeriyi kapat">×</button>
    {% if photoCount > 1 %}<button class="lightbox-arrow lightbox-prev" type="button" data-gallery-prev aria-label="Önceki fotoğraf">‹</button>{% endif %}
    <img src="{{ image }}" alt="{{ title }}" data-lightbox-image>
    {% if photoCount > 1 %}<button class="lightbox-arrow lightbox-next" type="button" data-gallery-next aria-label="Sonraki fotoğraf">›</button>{% endif %}
    <span class="lightbox-count" data-lightbox-count>1 / {{ photoCount }}</span>
  </div>
  <div class="detail-grid" style="margin-top:28px"><div><div class="detail-card"><div class="price">{{ price }}</div>
    <div class="specs">{% for feature in features %}<div class="spec"><small>Özellik</small><b>{{ feature }}</b></div>{% endfor %}</div>
    <h2>İlan Açıklaması</h2><div class="article-content">{{ content | safe }}</div>
    <h3>Konum avantajları</h3><div class="checks">{% for advantage in advantages %}<div class="check">{{ advantage }}</div>{% endfor %}</div>
  </div></div>
  <aside class="detail-card" style="align-self:start"><h3>Bu ilanla ilgileniyorum</h3><p style="color:var(--muted)">Detaylı bilgi ve gösterim randevusu için formu bırakın.</p><form data-whatsapp-form data-whatsapp-number="{{ site.phoneRaw }}"><input type="hidden" name="subject" value="{{ title }} ilanı hakkında bilgi"><input class="input" name="name" placeholder="Ad Soyad" required><br><br><input class="input" name="phone" placeholder="Telefon"><br><br><textarea class="input" name="message" required>Merhaba, bu ilan hakkında bilgi almak istiyorum.</textarea><br><br><button class="btn btn-primary" type="submit" style="width:100%">WhatsApp'tan Bilgi Talep Et</button></form></aside>
  </div>
</div></section>
