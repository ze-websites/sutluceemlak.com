<article class="blog-card"><img src="{{ post.data.image }}" alt="{{ post.data.title }}"><div class="content"><span class="badge {{ post.data.badgeColor or 'green' }}">{{ post.data.category }}</span><h3>{{ post.data.title }}</h3><p>{{ post.data.summary }}</p><a href="{{ post.url }}"><b>Yazıyı oku →</b></a></div></article>
